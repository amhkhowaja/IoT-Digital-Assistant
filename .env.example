# IoT Digital Assistant — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=IOTA

# NewsAPI (get your key at https://newsapi.org/register)
NEWS_API_KEY=your_newsapi_key_here

# Rasa
RASA_MODEL_PATH=/app/models
RASA_PORT=5005
ACTION_SERVER_URL=http://action-server:5055/webhook

# Self-Learning Pipeline
SKIP_CUSTOM_VALIDATION=false
RASA_CONFIDENCE_THRESHOLD=0.85

# Auto-Training (train Rasa model automatically after ETL)
ENABLE_AUTO_TRAIN=false

# GitHub (optional — only needed for 'make download-model' via gh CLI)
# Generate at: https://github.com/settings/tokens
# Required scope: repo (or fine-grained: Actions read)
GH_TOKEN=

# Container Registry (images are public, no auth needed to pull)
# docker pull ghcr.io/amhkhowaja/iot-action-server:latest
# docker pull ghcr.io/amhkhowaja/iot-airflow-pipeline:latest
